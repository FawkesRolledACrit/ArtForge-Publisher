# ArtForge Publisher Configuration

# Application Settings
PROJECT_NAME=ArtForge Publisher
PROJECT_DESCRIPTION=Local-first AI-powered art publishing assistant
VERSION=0.1.0

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./artforge.db

# LM Studio Settings
LM_STUDIO_ENDPOINT=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODEL=Qwen2.5-VL-7B-Instruct
LM_STUDIO_TIMEOUT=120

# File Upload Settings
MAX_IMAGE_SIZE_MB=50

# Storage Paths
STORAGE_PATH=./storage
PROMPTS_PATH=./prompts

# Logging
LOG_LEVEL=INFO
